            "description": "A customizable dropdown menu component.",
            "props": [
                {
                    "name": "options",
                    "type": "array",
                    "default": "[]",
                    "description": "Array of option objects {label, value}.",
                    "required": false
                },
                {
                    "name": "value",
                    "type": "any",
